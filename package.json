{
  "name": "smartscrolling",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "git:auto-sync": "node scripts/git-auto-sync.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:e2e:maestro": "maestro test .maestro --exclude-tags account",
    "test:e2e:maestro:account": "maestro test .maestro --include-tags account",
    "test:unit": "npm --workspace mobile run test:unit",
    "typecheck": "cd apps/mobile && npx tsc --noEmit",
    "check:edge-functions": "powershell -NoProfile -Command \"if (!(Test-Path 'supabase/functions/ai-chat/index.ts')) { throw 'Missing supabase/functions/ai-chat/index.ts' }; if (!(Test-Path 'supabase/functions/ai-definition/index.ts')) { throw 'Missing supabase/functions/ai-definition/index.ts' }; if (!(Test-Path 'supabase/functions/delete-account/index.ts')) { throw 'Missing supabase/functions/delete-account/index.ts' }; if (!(Test-Path 'supabase/functions/remote-push-smoke/index.ts')) { throw 'Missing supabase/functions/remote-push-smoke/index.ts' }; if (!(Test-Path 'supabase/functions/content-freshness-push/index.ts')) { throw 'Missing supabase/functions/content-freshness-push/index.ts' }\"",
    "books:ingest-sections": "npm --workspace @smartscrolling/pipeline run ingest:book-sections --",
    "books:cleanup-sections": "npm --workspace @smartscrolling/pipeline run cleanup:book-sections --",
    "facts:cleanup": "npm --workspace @smartscrolling/pipeline run cleanup:facts --",
    "facts:run-all": "npm --workspace @smartscrolling/pipeline run run:all --",
    "facts:daily-ingest": "npm --workspace @smartscrolling/pipeline run run:daily-ingest --",
    "facts:wikipedia-daily": "npm --workspace @smartscrolling/pipeline run run:wikipedia-daily --",
    "facts:wikipedia-catchup": "npm --workspace @smartscrolling/pipeline run run:wikipedia-catchup --",
    "facts:daily-check": "npm --workspace @smartscrolling/pipeline run check:facts-ingest-window --",
    "facts:weekly-check": "npm --workspace @smartscrolling/pipeline run check:facts-weekly-target --",
    "facts:report": "npm --workspace @smartscrolling/pipeline run report:facts --"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.1",
    "@electric-sql/pglite": "0.4.6",
    "@types/react": "^19.1.17",
    "eas-cli": "^18.7.0",
    "turbo": "^2.1.2"
  }
}
