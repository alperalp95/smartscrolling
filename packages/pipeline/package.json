{
  "name": "@smartscrolling/pipeline",
  "version": "1.0.0",
  "description": "AI data ingestion pipeline for SmartScrolling facts",
  "private": true,
  "type": "module",
  "scripts": {
    "run:wikipedia": "node src/runners/wikipedia.js",
    "run:nasa": "node src/runners/nasa.js",
    "run:pdf-curated": "node src/runners/pdf-curated.js",
    "run:reddit": "node src/runners/reddit.js",
    "run:all": "node src/runners/run-all.js",
    "run:daily-ingest": "node src/runners/daily-ingest.js",
    "run:wikipedia-daily": "node src/runners/run-all.js --wikipedia-lang tr --wikipedia-count 15 --target-saved 15 --max-candidates 90 --max-groq 45 --stanford-count 0 --medlineplus-count 0 --nasa-count 0 --pdf-curated-count 0",
    "run:wikipedia-catchup": "node src/runners/run-all.js --wikipedia-lang tr --wikipedia-count 50 --target-saved 50 --max-candidates 160 --max-groq 90 --stanford-count 0 --medlineplus-count 0 --nasa-count 0 --pdf-curated-count 0",
    "ingest:book-sections": "node src/runners/ingest-book-sections.js",
    "cleanup:book-sections": "node src/runners/cleanup-book-sections.js",
    "backfill:media": "node src/runners/backfill-fact-media.js",
    "backfill:visual-key": "node src/runners/backfill-fact-visual-keys.js",
    "cleanup:media": "node src/runners/cleanup-fact-media.js",
    "cleanup:facts": "node src/runners/cleanup-facts.js",
    "report:facts": "node src/runners/report-facts.js",
    "check:facts-ingest-window": "node src/runners/check-facts-ingest-window.js",
    "check:facts-weekly-target": "node src/runners/check-facts-weekly-target.js",
    "test:wikipedia-shadow": "node src/runners/test-wikipedia-shadow.js",
    "test:wikipedia-source": "node src/runners/test-wikipedia-source.js",
    "review:wikipedia-candidates": "node src/runners/review-wikipedia-candidates.js",
    "test:wikipedia-groq": "node src/runners/test-wikipedia-groq-dry-run.js",
    "test:fact-llm-shadow": "node src/runners/test-fact-llm-shadow.js"
  },
  "dependencies": {
    "groq-sdk": "^0.7.0",
    "@supabase/supabase-js": "^2.49.4",
    "node-fetch": "^3.3.2",
    "dotenv": "^16.4.5"
  }
}
